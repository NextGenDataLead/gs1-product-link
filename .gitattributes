# The operator's entry points are double-clicked, not run from a shell, so their line
# endings have to be right for the platform that runs them regardless of anyone's
# core.autocrlf setting. cmd.exe mis-parses labels and `goto` in a .bat checked out with
# bare LF endings, which fails as a batch file that silently does the wrong thing.
*.bat text eol=crlf
*.command text eol=lf

# uv.lock is generated, so it is collapsed by default in a review rather than read line by
# line. It is still committed and still diffable — `uv lock --check` in CI is what actually
# guards it.
uv.lock linguist-generated=true
