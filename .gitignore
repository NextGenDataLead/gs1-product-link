# === Secrets & per-client config (never commit) ===
.env
.env.*
!.env.example
clients.yml
*.key
*.pem
*.p12
credentials.json
secrets.*

# === Tool inputs/outputs ===
# The directories are tracked (via .gitkeep) so a fresh clone has somewhere to put
# an export and somewhere to write results. Everything inside them stays ignored:
# input/ holds client exports and media, output/ holds state.json, plans and run logs.
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# === Python ===
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
uv.lock

# === Node / TypeScript ===
node_modules/
dist/
build/
npm-debug.log*
yarn-error.log*

# === OS & editor ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
